APP_NAME="Парсер отзывов Яндекс.Карт"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=reviews_parser
DB_USERNAME=sail
DB_PASSWORD=password

REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000
SESSION_DRIVER=cookie
SESSION_DOMAIN=localhost

PARSING_HTTP_TIMEOUT=30
PARSING_THROTTLE_MIN_MS=500
PARSING_THROTTLE_MAX_MS=1500
PARSING_MAX_RETRIES=3
PARSING_MAX_LAYOUT_FAILURES=3
PARSING_REVIEWS_PER_PAGE=20
PARSING_MAX_PAGES=30
PARSING_SKIPPED_THRESHOLD=0.5

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
REDIS_CLIENT=predis
